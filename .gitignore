# 빌드 산출물. `npm run build` 한 번이면 원본에서 그대로 다시 나온다.
# 저장소에 넣어두면 원본과 배포본이 따로 늙는다 — 실제로 그랬다.
dist/

# 판 나누기 빌드 산출물(무료판/전체판). `node build_editions.mjs`가 다시 만든다.
dist-editions/

# 소리의 생성 원본. 게임에 실리는 것은 assets/audio 아래의 완성본뿐이고,
# 원본이 필요하면 tools/audio 스크립트로 다시 받으면 된다. 저장소 이력이 이미
# 무거워서 두 벌을 다 넣을 이유가 없다.
assets/audio/raw/
assets/audio/_work/

node_modules/
*.log
.DS_Store
Thumbs.db

# 초상 사진의 원본. 게임에 실리는 것은 assets/commanders 아래로 잘라낸
# 144x160 한 장뿐이고, 원본이 필요하면 tools/portraits 스크립트로 다시 받으면 된다.
tools/portraits/raw/

# 폰 화면 실측판. tools/layout/build_probe.py 가 필요할 때 찍어 내는 것이라
# 저장소에는 안 올린다. index.html 복사본이라 두면 조용히 낡는다.
_probe_*.html

# 실측판이 뱉는 중간 파일. 매번 다시 만들어진다.
dom.txt
probe.txt
w2.txt
phone4.png
tools/layout/__pycache__/

# 자동 플레이 검사 결과. 매번 다시 만들어진다.
tools/tester/out/
